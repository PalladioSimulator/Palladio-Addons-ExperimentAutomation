<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="org.palladiosimulator.experimentautomation.application.feature"
      label="Experiment Automation Application Feature"
      version="6.0.0.qualifier"
      plugin="org.palladiosimulator.branding"
      license-feature="org.palladiosimulator.license"
      license-feature-version="1.0.0">

   <description url="https://sdqweb.ipd.kit.edu/wiki/Palladio_Experiment_Automation">
      The Palladio Experiment Automation enables automatic execution of Palladio simulation runs. Allows to specify experiment runs for arbitrary solvers within a model; also supports experiment variations, e.g., for sensitivity analyses.
   </description>

   <requires>
      <import plugin="de.uka.ipd.sdq.simucomframework"/>
      <import plugin="de.uka.ipd.sdq.codegen.simucontroller"/>
      <import plugin="org.palladiosimulator.analyzer.workflow"/>
      <import plugin="de.uka.ipd.sdq.simucomframework.simucomstatus"/>
      <import plugin="org.palladiosimulator.experimentautomation"/>
      <import plugin="org.palladiosimulator.edp2.dao"/>
      <import plugin="org.palladiosimulator.edp2.util"/>
      <import plugin="org.palladiosimulator.commons"/>
      <import plugin="org.jscience"/>
      <import plugin="org.palladiosimulator.recorderframework"/>
      <import plugin="org.palladiosimulator.simulizar.reconfiguration.storydiagram"/>
      <import plugin="org.palladiosimulator.servicelevelobjective.edp2"/>
      <import plugin="org.palladiosimulator.recorderframework.edp2"/>
      <import plugin="org.palladiosimulator.simulizar"/>
      <import plugin="org.palladiosimulator.edp2.datastream"/>
      <import plugin="org.palladiosimulator.measurementframework"/>
      <import plugin="org.palladiosimulator.edp2.repository.local"/>
      <import plugin="org.eclipse.core.runtime"/>
      <import plugin="org.palladiosimulator.branding"/>
   </requires>

   <plugin
         id="org.palladiosimulator.experimentautomation.application"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.palladiosimulator.experimentautomation.application.ui"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

</feature>
